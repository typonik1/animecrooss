+def dashboard_text(*, enabled: bool, counts: dict[str, int], slots: list[str]) -> str:
+    state = "🟢 <b>Бот работает</b>" if enabled else "🔴 <b>Бот приостановлен</b>"
+    schedule = " · ".join(escape(slot) for slot in slots) or "не задано"
+    return "\n".join(
