+        builder.storage,
+        "get_list",
+        lambda key: ["10:00", "13:00", "18:00", "21:00"],
+    )
+    monkeypatch.setattr(builder.storage, "list_queue", lambda day: [])
+    free_calls = []
+    monkeypatch.setattr(
+        builder.storage,
+        "free_slots",
+        lambda day, slots: free_calls.append((day, slots)) or slots,
+    )
+    enqueued = []
+    monkeypatch.setattr(
+        builder.storage,
+        "enqueue",
+        lambda day, slot, selected: enqueued.append((day, slot, selected["message_id"])),
+    )
