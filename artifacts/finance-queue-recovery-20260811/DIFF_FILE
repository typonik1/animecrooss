+def test_message_not_modified_is_a_successful_noop_without_unicode_retry():
+    import admin
+    from telethon.errors import MessageNotModifiedError
+
+    class Event:
+        def __init__(self):
+            self.calls = 0
+
+        async def edit(self, text, **kwargs):
+            self.calls += 1
+            raise MessageNotModifiedError(request=None)
+
+    premiums = []
+
+    def buttons(premium):
+        premiums.append(premium)
+        return [[f"premium={premium}"]]
+
+    event = Event()
+    assert asyncio.run(admin.edit_view(event, "same", buttons)) is None
+    assert event.calls == 1
+    assert premiums == [True]
+
+
+def test_refresh_queue_uses_planning_day_selected_by_builder(monkeypatch):
+    import admin
+
+    calls = []
+    monkeypatch.setattr(admin.builder, "queue_day", lambda: "2026-08-12")
+    monkeypatch.setattr(
+        admin.storage,
+        "pending_count",
+        lambda day: calls.append(("pending", day)) or 0,
+    )
+
+    async def build_day(reader, day):
+        calls.append(("build", reader, day))
+        return 4
+
+    monkeypatch.setattr(admin.builder, "build_day", build_day)
+
+    assert asyncio.run(admin.refresh_queue("reader")) == (0, 4)
+    assert calls == [
+        ("pending", "2026-08-12"),
+        ("build", "reader", "2026-08-12"),
+    ]
